const { app, BrowserWindow, ipcMain, Tray, Menu, dialog } = require('electron');
const path = require('path');
const Store = require('electron-store');
const { AccountManager } = require('./account-manager');
const { WindowManager } = require('./window-manager');

// 加密密钥，实际应用中应该使用更安全的方式生成和存储
const ENCRYPTION_KEY = 'waimai-account-manager-secure-key';

// 全局引用，防止被垃圾回收
let mainWindow;
let tray;
let accountManager;
let windowManager;
let isQuitting = false;

// 初始化应用
function initApp() {
  windowManager = new WindowManager();
  accountManager = new AccountManager(ENCRYPTION_KEY, windowManager);
  
  createMainWindow();
  createTray();
  setupIPC();
}

// 创建主窗口
function createMainWindow() {
  mainWindow = new BrowserWindow({
    width: 900,
    height: 700,
    minWidth: 800,
    minHeight: 600,
    webPreferences: {
      nodeIntegration: false,
      contextIsolation: true,
      preload: path.join(__dirname, 'preload.js')
    },
    icon: path.join(__dirname, '../../public/icon.png')
  });

  // 加载主界面
  mainWindow.loadFile(path.join(__dirname, '../../public/index.html'));

  // 窗口关闭时隐藏而不是退出
  mainWindow.on('close', (e) => {
    if (!isQuitting) {
      e.preventDefault();
      mainWindow.hide();
      return false;
    }
    return true;
  });

  // 开发环境打开开发者工具
  if (process.env.NODE_ENV === 'development') {
    mainWindow.webContents.openDevTools();
  }
}

// 创建系统托盘
function createTray() {
  tray = new Tray(path.join(__dirname, '../../public/icon.png'));
  
  function updateTrayMenu() {
    const accounts = accountManager.getAccounts();
    
    const contextMenu = Menu.buildFromTemplate([
      { label: '外卖平台账号管理器', enabled: false },
      { type: 'separator' },
      ...accounts.map(account => ({
        label: `${account.nickname || account.username} ${account.platform === 'meituan' ? '(美团)' : '(京东)'} ${account.isLoggedIn ? '✓' : ''}`,
        click: () => {
          accountManager.showAccountWindow(account.id);
        }
      })),
      { type: 'separator' },
      { 
        label: '显示主窗口', 
        click: () => { 
          if (mainWindow) {
            mainWindow.show();
            mainWindow.focus();
          }
        } 
      },
      { 
        label: '退出', 
        click: () => { 
          isQuitting = true;
          app.quit(); 
        } 
      }
    ]);
    
    tray.setContextMenu(contextMenu);
  }
  
  // 初始设置托盘菜单
  updateTrayMenu();
  
  // 定期更新托盘菜单以反映最新状态
  setInterval(updateTrayMenu, 30000);
  
  tray.setToolTip('外卖平台账号管理器');
  tray.on('click', () => {
    if (mainWindow) {
      mainWindow.show();
      mainWindow.focus();
    }
  });
}

// 设置IPC通信
function setupIPC() {
  // 获取所有账号
  ipcMain.handle('get-accounts', () => {
    return accountManager.getAccounts();
  });
  
  // 添加账号
  ipcMain.handle('add-account', (event, accountData) => {
    try {
      return accountManager.addAccount(accountData);
    } catch (error) {
      dialog.showErrorBox('添加账号失败', error.message);
      return null;
    }
  });
  
  // 登录账号
  ipcMain.handle('login-account', (event, accountId) => {
    try {
      return accountManager.showAccountWindow(accountId);
    } catch (error) {
      dialog.showErrorBox('登录失败', error.message);
      return false;
    }
  });
  
  // 删除账号
  ipcMain.handle('delete-account', (event, accountId) => {
    try {
      return accountManager.deleteAccount(accountId);
    } catch (error) {
      dialog.showErrorBox('删除账号失败', error.message);
      return false;
    }
  });

  // 编辑账号
  ipcMain.handle('edit-account', (event, accountData) => {
    try {
      return accountManager.updateAccount(accountData);
    } catch (error) {
      dialog.showErrorBox('更新账号失败', error.message);
      return false;
    }
  });

  // 刷新账号状态
  ipcMain.handle('refresh-account-status', () => {
    try {
      return accountManager.refreshAccountStatus();
    } catch (error) {
      console.error('刷新账号状态失败:', error);
      return false;
    }
  });

  // 获取平台列表
  ipcMain.handle('get-platforms', () => {
    return [
      { id: 'meituan', name: '美团外卖', url: 'https://e.waimai.meituan.com' },
      { id: 'jingdong', name: '京东外卖', url: 'https://store.jddj.com' }
    ];
  });
}

// 应用就绪时初始化
app.whenReady().then(() => {
  initApp();
  
  app.on('activate', () => {
    if (BrowserWindow.getAllWindows().length === 0) {
      createMainWindow();
    } else if (mainWindow) {
      mainWindow.show();
    }
  });
});

// 防止应用多开
const gotTheLock = app.requestSingleInstanceLock();
if (!gotTheLock) {
  app.quit();
} else {
  app.on('second-instance', () => {
    if (mainWindow) {
      if (mainWindow.isMinimized()) mainWindow.restore();
      mainWindow.show();
      mainWindow.focus();
    }
  });
}

// 所有窗口关闭时退出应用
app.on('window-all-closed', () => {
  if (process.platform !== 'darwin') {
    app.quit();
  }
});

// 应用退出前清理
app.on('before-quit', () => {
  isQuitting = true;
}); 